# All optional. Copy to .env.local and fill in what you need.

# Business identity printed on invoices (defaults: a fictional studio)
BUSINESS_NAME=
BUSINESS_TAGLINE=
BUSINESS_EMAIL=
BUSINESS_WEBSITE=
# Free-text payment line at the bottom of each invoice
PAYMENT_INSTRUCTIONS=

# Invoice numbering: prefix (default INV) and scheme "sequential" (INV-0001) or "yearly" (INV-2026-001)
INVOICE_PREFIX=
INVOICE_NUMBERING=
# Payment terms in days (default 14, i.e. Net 14)
NET_DAYS=

# Restricted Stripe key with read access to Balance; shows the live balance when set
STRIPE_SECRET_KEY=

# Where your records live (default ./data; falls back to ./data/example when a file is missing)
MONEY_DATA_DIR=
# Pin "today" (YYYY-MM-DD) for demos and screenshots
DEMO_NOW=
# Set to 1 to disable issuing invoices and marking them paid (for a public demo deploy)
READ_ONLY=
